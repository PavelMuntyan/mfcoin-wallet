{
  "manifest_version": 3,
  "name": "MFCoin Wallet",
  "short_name": "MFCoin",
  "description": "A minimal, security-first wallet for MFCoin.",
  "version": "0.6.6",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MFCoin Wallet",
    "default_popup": "index.html",
    "openPanelOnActionClick": true,
    "default_icon": {
      "16": "images/mfcoin-16.png",
      "32": "images/mfcoin-32.png"
    }
  },
  "icons": {
    "16": "images/mfcoin-16.png",
    "32": "images/mfcoin-32.png",
    "48": "images/mfcoin-48.png",
    "128": "images/mfcoin-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://mf.life wss://mf.life"
  }
}
