{
  "manifest_version": 3,
  "name": "MFCoin Wallet",
  "short_name": "MFCoin",
  "description": "A minimal, security-first wallet for MFCoin.",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MFCoin Wallet",
    "default_popup": "index.html"
  },
  "icons": {
    "128": "images/mfcoin-original.svg"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://mf.life wss://mf.life"
  }
}
